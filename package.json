{
  "name": "gas-source-localization-lab",
  "private": true,
  "version": "0.20.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:portable": "node scripts/build-portable.mjs",
    "test": "vitest run",
    "test:research": "vitest --config scripts/vitest.headless.config.ts run",
    "benchmark:design": "BENCHMARK_RUN=1 BENCHMARK_DRY_RUN=1 vitest --config scripts/vitest.headless.config.ts run scripts/headless-benchmark.cli.test.ts",
    "benchmark:ci": "vite-node scripts/local-sharded-benchmark.ts --profile commissioning --output benchmark-output/local-commissioning --workers 1",
    "benchmark:local": "vite-node scripts/local-sharded-benchmark.ts",
    "benchmark:local:integration": "LOCAL_SHARD_INTEGRATION=1 vitest --config scripts/vitest.headless.config.ts run scripts/local-sharded-benchmark.cli.test.ts",
    "phase2:design": "PHASE2_PILOT_WRITE=1 PHASE2_PILOT_OUTPUT_DIR=research/protocols/phase2_development_pilot vitest --config scripts/vitest.headless.config.ts run scripts/phase2-pilot-manifest.cli.test.ts",
    "phase2:dry-run": "PHASE2_PILOT_RUN=1 PHASE2_PILOT_DRY_RUN=1 vitest --config scripts/vitest.headless.config.ts run scripts/phase2-pilot-runner.cli.test.ts",
    "phase2:run": "PHASE2_PILOT_RUN=1 PHASE2_PILOT_DRY_RUN=0 vitest --config scripts/vitest.headless.config.ts run scripts/phase2-pilot-runner.cli.test.ts",
    "m4:analyze": "vite-node scripts/m4-pilot-analysis.ts",
    "m5:design": "M5_DEVELOPMENT_WRITE=1 vitest --config scripts/vitest.headless.config.ts run scripts/m5-development-manifest.cli.test.ts",
    "m5:dry-run": "vite-node scripts/local-sharded-benchmark.ts --profile m5-development --output /private/tmp/plumenav-m5-development-screen-2026-09-02 --workers 6 --dry-run",
    "m5:run": "vite-node scripts/local-sharded-benchmark.ts --profile m5-development --output /private/tmp/plumenav-m5-development-screen-2026-09-02 --workers 6 --resume",
    "m6:design": "M6_CALIBRATION_WRITE=1 vitest --config scripts/vitest.headless.config.ts run scripts/m6-calibration-manifest.cli.test.ts",
    "m6:dry-run": "vite-node scripts/local-m6-calibration.ts --output /private/tmp/plumenav-m6-calibration-2026-09-02 --workers 6 --dry-run",
    "m6:run": "vite-node scripts/local-m6-calibration.ts --output /private/tmp/plumenav-m6-calibration-2026-09-02 --workers 6 --resume",
    "m6:verify": "M6_VERIFY_RUN=1 vite-node scripts/m6-verify-results.ts research/evidence/m6_quad_calibration_2026-09-03",
    "m6:analyze": "M6_ANALYSIS_RUN=1 vite-node scripts/m6-calibration-analysis.ts research/evidence/m6_quad_calibration_2026-09-03 research/analysis/m6_quad_calibration_2026-09-03",
    "m7:design": "M7_PRE_CANDIDATE_WRITE=1 M7_PRE_CANDIDATE_OUTPUT_DIR=research/protocols/m7_precandidate_diagnostic vitest --config scripts/vitest.headless.config.ts run scripts/m7-precandidate-manifest.cli.test.ts",
    "m7:smoke": "vite-node scripts/m7-telemetry-smoke.ts",
    "m7:dry-run": "vite-node scripts/local-m7-diagnostic.ts --output /private/tmp/plumenav-m7-precandidate-2026-09-03 --workers 6 --dry-run",
    "m7:run": "vite-node scripts/local-m7-diagnostic.ts --output /private/tmp/plumenav-m7-precandidate-2026-09-03 --workers 6 --resume",
    "m7:verify": "M7_VERIFY_RUN=1 vite-node scripts/m7-verify-results.ts research/evidence/m7_precandidate_diagnostic_2026-09-03",
    "m7:analyze": "M7_ANALYSIS_RUN=1 vite-node scripts/m7-precandidate-analysis.ts research/evidence/m7_precandidate_diagnostic_2026-09-03 research/analysis/m7_precandidate_diagnostic_2026-09-03",
    "m8:design": "M8_STAGED_VERIFICATION_WRITE=1 M8_STAGED_VERIFICATION_OUTPUT_DIR=research/protocols/m8_staged_policy_verification vitest --config scripts/vitest.headless.config.ts run scripts/m8-staged-verification-manifest.cli.test.ts",
    "m8:dry-run": "vite-node scripts/local-m8-verification.ts --output /private/tmp/plumenav-m8-staged-verification-2026-09-04 --workers 6 --dry-run",
    "m8:run": "vite-node scripts/local-m8-verification.ts --output /private/tmp/plumenav-m8-staged-verification-2026-09-04 --workers 6 --resume",
    "m8:verify": "M8_VERIFY_RUN=1 vite-node scripts/m8-verify-results.ts research/evidence/m8_staged_policy_verification_2026-09-04",
    "m8:analyze": "M8_ANALYSIS_RUN=1 vite-node scripts/m8-staged-verification-analysis.ts research/evidence/m8_staged_policy_verification_2026-09-04 research/analysis/m8_staged_policy_verification_2026-09-04",
    "m9:design": "M9_ADAPTIVE_DEVELOPMENT_WRITE=1 M9_ADAPTIVE_DEVELOPMENT_OUTPUT_DIR=research/protocols/m9_adaptive_viewpoint_development vitest --config scripts/vitest.headless.config.ts run scripts/m9-adaptive-development-manifest.cli.test.ts",
    "m9:dry-run": "vite-node scripts/local-m9-development.ts --output /private/tmp/plumenav-m9-adaptive-development-2026-09-04 --workers 6 --dry-run",
    "m9:run": "vite-node scripts/local-m9-development.ts --output /private/tmp/plumenav-m9-adaptive-development-2026-09-04 --workers 6 --resume",
    "m9:verify": "M9_VERIFY_RUN=1 vite-node scripts/m9-verify-results.ts research/evidence/m9_adaptive_viewpoint_development_2026-09-04",
    "m9:analyze": "M9_ANALYSIS_RUN=1 vite-node scripts/m9-adaptive-development-analysis.ts research/evidence/m9_adaptive_viewpoint_development_2026-09-04 research/analysis/m9_adaptive_viewpoint_development_2026-09-04",
    "m10:design": "M10_GEOMETRY_DEVELOPMENT_WRITE=1 M10_GEOMETRY_DEVELOPMENT_OUTPUT_DIR=research/protocols/m10_geometry_conditioned_development vitest --config scripts/vitest.headless.config.ts run scripts/m10-geometry-development-manifest.cli.test.ts",
    "m10:dry-run": "vite-node scripts/local-m10-development.ts --output /private/tmp/plumenav-m10-geometry-development-2026-09-05 --workers 6 --dry-run",
    "m10:run": "vite-node scripts/local-m10-development.ts --output /private/tmp/plumenav-m10-geometry-development-2026-09-05 --workers 6 --resume",
    "phase3:safety-design": "PHASE3_SAFETY_WRITE=1 PHASE3_SAFETY_OUTPUT_DIR=research/protocols/phase3_source_absent_safety vitest --config scripts/vitest.headless.config.ts run scripts/phase3-source-absent-manifest.cli.test.ts",
    "phase3:safety-dry-run": "PHASE3_SAFETY_RUN=1 PHASE3_SAFETY_DRY_RUN=1 vitest --config scripts/vitest.headless.config.ts run scripts/phase3-safety-runner.cli.test.ts",
    "phase3:safety-run": "PHASE3_SAFETY_RUN=1 PHASE3_SAFETY_DRY_RUN=0 vitest --config scripts/vitest.headless.config.ts run scripts/phase3-safety-runner.cli.test.ts",
    "baseline:replay-evidence": "node scripts/run-baseline-replay-evidence.mjs",
    "baseline:replay-verify": "node scripts/run-baseline-replay-evidence.mjs --verify",
    "literature:normalize": "node scripts/literature/normalize-wos-ris.mjs",
    "literature:normalize:pubmed": "node scripts/literature/normalize-pubmed-nbib.mjs",
    "literature:screening-inputs": "node scripts/literature/build-screening-inputs.mjs",
    "literature:triage-summary": "node scripts/literature/summarize-candidate-triage.mjs",
    "literature:second-review-inputs": "node scripts/literature/build-second-review-inputs.mjs",
    "literature:second-review-summary": "node scripts/literature/summarize-second-reviews.mjs",
    "literature:reroute-input": "node scripts/literature/build-cross-strand-reroute-input.mjs",
    "literature:reroute-second-input": "node scripts/literature/build-cross-strand-second-review-input.mjs",
    "literature:reroute-summary": "node scripts/literature/summarize-cross-strand-reroute.mjs",
    "literature:validate:pmc": "node scripts/literature/validate-pmc-fulltext.mjs",
    "literature:human-screening-ledger": "node scripts/literature/build-human-screening-all-records.mjs",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vite-node": "3.2.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.9.0"
}
